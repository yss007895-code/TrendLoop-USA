    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8049649445649586" crossorigin="anonymous"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', -apple-system, sans-serif; line-height: 1.6; color: #1a1a2e; background: #ffffff; }

        :root {
            --bg: #ffffff;
            --bg-off: #f8f9fa;
            --text: #1a1a2e;
            --text-light: #6b7280;
            --text-muted: #9ca3af;
            --border: #e5e7eb;
            --pink: #ff2d55;
            --pink-light: #fff0f3;
            --blue: #0066ff;
            --blue-light: #eef4ff;
            --lime: #32d74b;
            --lime-light: #edfff0;
            --orange: #ff6b00;
            --orange-light: #fff5eb;
            --purple: #af52de;
            --purple-light: #f8f0ff;
            --yellow: #ffd60a;
            --yellow-light: #fffde6;
        }

        /* === NAVIGATION === */
        .nav { background: var(--bg); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; }
        .nav-ticker { background: var(--pink); padding: 6px 0; text-align: center; overflow: hidden; }
        .nav-ticker span { color: #fff; font-family: 'Barlow Condensed', sans-serif; font-size: 0.7em; font-weight: 700; text-transform: uppercase; letter-spacing: 3px; }
        .nav-inner { max-width: 1200px; margin: 0 auto; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; height: 60px; }
        .nav-brand { font-family: 'Barlow Condensed', sans-serif; font-size: 1.8em; font-weight: 900; color: var(--text); text-decoration: none; text-transform: uppercase; letter-spacing: -0.5px; }
        .nav-brand span { color: var(--pink); }
        .nav-links { display: flex; gap: 4px; list-style: none; }
        .nav-links a { color: var(--text-light); text-decoration: none; font-size: 0.78em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; padding: 6px 12px; border-radius: 20px; transition: all 0.2s; }
        .nav-links a:hover { color: var(--pink); background: var(--pink-light); }
        .nav-toggle { display: none; background: none; border: none; font-size: 1.5em; cursor: pointer; color: var(--text); }

        /* === CATEGORY PILLS === */
        .categories { padding: 12px 20px; overflow-x: auto; white-space: nowrap; border-bottom: 1px solid var(--border); background: var(--bg-off); -webkit-overflow-scrolling: touch; }
        .categories::-webkit-scrollbar { display: none; }
        .cat-inner { max-width: 1200px; margin: 0 auto; display: flex; gap: 8px; }
        .cat-pill { display: inline-block; padding: 6px 16px; border-radius: 20px; font-size: 0.75em; font-weight: 600; text-decoration: none; transition: all 0.2s; border: 1.5px solid transparent; white-space: nowrap; }
        .cat-pill.active { background: var(--pink); color: #fff; border-color: var(--pink); }
        .cat-pill:not(.active) { color: var(--text-light); border-color: var(--border); background: var(--bg); }
        .cat-pill:not(.active):hover { border-color: var(--pink); color: var(--pink); }

        /* === HERO === */
        .hero { position: relative; overflow: hidden; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 380px; display: flex; align-items: center; }
        .hero-content { max-width: 1200px; margin: 0 auto; padding: 50px 24px; width: 100%; position: relative; z-index: 2; }
        .hero-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--pink); color: #fff; font-family: 'Barlow Condensed', sans-serif; font-size: 0.65em; font-weight: 700; padding: 5px 14px; text-transform: uppercase; letter-spacing: 2px; border-radius: 4px; margin-bottom: 20px; }
        .hero-badge .dot { width: 6px; height: 6px; background: #fff; border-radius: 50%; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
        .hero h1 { font-family: 'Barlow Condensed', sans-serif; font-size: 3.5em; font-weight: 900; color: #fff; line-height: 1.05; text-transform: uppercase; margin-bottom: 16px; max-width: 700px; }
        .hero h1 em { font-style: normal; color: var(--pink); }
        .hero p { color: rgba(255,255,255,0.7); font-size: 1.05em; max-width: 550px; line-height: 1.7; }
        .hero-shapes { position: absolute; right: -50px; top: -50px; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(255,45,85,0.15) 0%, transparent 70%); z-index: 1; }
        .hero-shapes2 { position: absolute; left: 30%; bottom: -100px; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(0,102,255,0.1) 0%, transparent 70%); z-index: 1; }

        /* === CONTAINER === */
        .container { max-width: 1200px; margin: 0 auto; padding: 32px 20px; }

        /* === SECTION HEADERS === */
        .section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
        .section-head h2 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.6em; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text); }
        .section-head .more { font-size: 0.78em; font-weight: 600; color: var(--pink); text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px; }
        .section-head .more:hover { text-decoration: underline; }

        /* === CARD GRID === */
        .grid-featured { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; margin-bottom: 32px; }
        .grid-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 32px; }

        .card { background: var(--bg); border-radius: 12px; overflow: hidden; border: 1px solid var(--border); transition: all 0.25s; }
        .card:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(0,0,0,0.1); border-color: transparent; }
        .card a { text-decoration: none; color: inherit; display: block; }
        .card-img { width: 100%; object-fit: cover; display: block; }
        .card-big .card-img { height: 320px; }
        .card-sm .card-img { height: 180px; }
        .card-body { padding: 16px 18px; }
        .card-tag { display: inline-block; font-family: 'Barlow Condensed', sans-serif; font-size: 0.65em; font-weight: 700; padding: 3px 10px; text-transform: uppercase; letter-spacing: 1.5px; border-radius: 4px; margin-bottom: 8px; }
        .tag-trending { background: var(--pink-light); color: var(--pink); }
        .tag-guide { background: var(--blue-light); color: var(--blue); }
        .tag-hot { background: var(--orange-light); color: var(--orange); }
        .tag-style { background: var(--purple-light); color: var(--purple); }
        .tag-budget { background: var(--lime-light); color: #1a8f2d; }
        .tag-featured { background: var(--yellow-light); color: #b8960c; }
        .card h3 { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; line-height: 1.25; color: var(--text); text-transform: uppercase; margin-bottom: 8px; }
        .card-big h3 { font-size: 1.5em; }
        .card-sm h3 { font-size: 1.1em; }
        .card .excerpt { color: var(--text-light); font-size: 0.85em; line-height: 1.6; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .card .meta { color: var(--text-muted); font-size: 0.72em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }

        /* Gradient image placeholders (replacing Unsplash) */
        .img-placeholder { width: 100%; display: flex; align-items: center; justify-content: center; font-family: 'Barlow Condensed', sans-serif; font-size: 3em; font-weight: 900; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 2px; }
        .img-fashion { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .img-summer { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
        .img-handbag { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
        .img-luxury { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
        .img-alert { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }
        .img-eco { background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); }
        .img-blazer { background: linear-gradient(135deg, #fccb90 0%, #d57eeb 100%); }
        .img-denim { background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%); }
        .img-capsule { background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); }

        /* === DISCLOSURE === */
        .disclosure { background: var(--bg-off); border-left: 4px solid var(--pink); border-radius: 0 8px 8px 0; padding: 14px 20px; margin-bottom: 24px; font-size: 0.82em; color: var(--text-light); }
        .disclosure a { color: var(--pink); text-decoration: none; font-weight: 600; }
        .disclosure a:hover { text-decoration: underline; }

        /* === AD SLOT === */
        .ad-slot { background: var(--bg-off); border: 1px dashed var(--border); border-radius: 8px; padding: 24px; text-align: center; margin: 24px 0; color: var(--text-muted); font-size: 0.82em; min-height: 90px; display: flex; align-items: center; justify-content: center; }

        /* === FOOTER === */
        .footer { background: var(--text); color: rgba(255,255,255,0.5); padding: 48px 20px 24px; margin-top: 40px; }
        .footer-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; }
        .footer h4 { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 1em; color: #fff; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; }
        .footer p { font-size: 0.85em; line-height: 1.8; }
        .footer a { color: var(--pink); text-decoration: none; }
        .footer a:hover { color: #fff; }
        .footer-links { list-style: none; }
        .footer-links li { margin-bottom: 8px; }
        .footer-links a { color: rgba(255,255,255,0.5); font-size: 0.85em; }
        .footer-links a:hover { color: var(--pink); }
        .footer-bottom { max-width: 1200px; margin: 24px auto 0; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; font-size: 0.75em; color: rgba(255,255,255,0.3); }

        /* === MOBILE === */
        @media (max-width: 768px) {
            .hero { min-height: 300px; }
            .hero h1 { font-size: 2.2em; }
            .grid-featured { grid-template-columns: 1fr; }
            .card-big .card-img { height: 220px; }
            .grid-cards { grid-template-columns: 1fr; }
            .footer-inner { grid-template-columns: 1fr; gap: 24px; }
            .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
            .nav-links { display: none; position: absolute; top: 60px; left: 0; right: 0; background: var(--bg); flex-direction: column; padding: 12px 20px; border-bottom: 1px solid var(--border); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
            .nav-links.open { display: flex; }
            .nav-links a { padding: 10px 0; border-radius: 0; }
            .nav-toggle { display: block; }
            .hero-shapes, .hero-shapes2 { display: none; }
        }
    </style>
</head>
